#!/bin/bash

MENU="/usr/lib/i3-wallpaper-rofi/wallpaper-menu"
WALLPAPER="/usr/bin/wallpaper"

if [ ! -x "$MENU" ]; then
    echo "Wallpaper menu not found:"
    echo "$MENU"
    exit 1
fi

if [ ! -x "$WALLPAPER" ]; then
    echo "Wallpaper command not found:"
    echo "$WALLPAPER"
    exit 1
fi

choice=$("$MENU")

[ -z "$choice" ] && exit 0

exec "$WALLPAPER" "$choice"
